# Copy to backend/.env for local development. Never commit the real .env.
APP_NAME=MailPilot
ENVIRONMENT=development
# Comma-separated exact origins. Do not use '*' or include paths/credentials.
# The first origin is where OAuth success/error redirects land.
# Add http://localhost:4173 here if you test the built app with `npm run preview`.
FRONTEND_ORIGIN=http://localhost:5173
# MongoDB URI is never logged. Use mongodb+srv://... (no port) for Atlas.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=mailpilot

# --- Phase 2: development-only session + Gmail OAuth ---
# Generate locally and paste below. Do not commit the filled-in .env.
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
# At least 32 characters. Leave empty in development/test to use an ephemeral key
# (sessions die on restart). Required in staging/production.
SESSION_SECRET_KEY=
# SESSION_MAX_AGE_SECONDS=1209600
# SESSION_COOKIE_SECURE=false
# SameSite none requires SESSION_COOKIE_SECURE=true.
# SESSION_COOKIE_SAMESITE=lax
# OAUTH_STATE_TTL_SECONDS=600
# GMAIL_SYNC_BATCH_SIZE=10

# Fernet key used to encrypt Gmail tokens before they are written to MongoDB.
# Required before connecting Gmail (Gmail routes return 503 until it is set).
# Required at startup in staging/production. Generate locally:
#   .\.venv\Scripts\python.exe -c "from app.core.crypto import generate_key; print(generate_key())"
TOKEN_ENCRYPTION_KEY=

# Google Cloud OAuth client. Both must be set together, and only on the server.
# Register this exact redirect URI on the OAuth client:
#   http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Reserved for Phase 3 (not used yet). Keep server-side; never expose via VITE_*.
GROQ_API_KEY=
LLM_MODEL=
